// VoyageNest Database Schema
// Using SQLite for simplicity - can be easily migrated to PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// User Management
// ============================================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  phone         String?
  role          String   @default("customer") // admin | customer
  customerScore Int      @default(0) @map("customer_score")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  bookings         Booking[]
  chatSessionsUser ChatSession[] @relation("UserSessions")
  chatSessionsAdmin ChatSession[] @relation("AdminSessions")
  chatMessages     ChatMessage[]
  systemLogs       SystemLog[]

  @@map("users")
}

// ============================================================
// Properties
// ============================================================

model Property {
  id              String   @id @default(cuid())
  titleDe         String   @map("title_de")
  titleEn         String   @map("title_en")
  descriptionDe   String   @map("description_de")
  descriptionEn   String   @map("description_en")
  countryId       String   @map("country_id")
  address         String
  pricePerNight   Float    @map("price_per_night")
  maxGuests       Int      @map("max_guests")
  bedrooms        Int
  bathrooms       Int
  amenities       String   @default("[]") // JSON array stored as string
  images          String   @default("[]") // JSON array stored as string
  isActive        Boolean  @default(true) @map("is_active")
  airbnbImportId  String?  @unique @map("airbnb_import_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  country       Country       @relation(fields: [countryId], references: [id])
  airbnbImport  AirbnbImport? @relation(fields: [airbnbImportId], references: [id])
  bookings      Booking[]
  categories    PropertyCategory[]

  @@map("properties")
}

model Country {
  id        String   @id @default(cuid())
  nameDe    String   @map("name_de")
  nameEn    String   @map("name_en")
  code      String   @unique
  flagEmoji String   @map("flag_emoji")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  properties Property[]

  @@map("countries")
}

model Category {
  id        String   @id @default(cuid())
  nameDe    String   @map("name_de")
  nameEn    String   @map("name_en")
  slug      String   @unique
  icon      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  properties PropertyCategory[]

  @@map("categories")
}

// Junction table for Property-Category many-to-many relationship
model PropertyCategory {
  propertyId String   @map("property_id")
  categoryId String   @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([propertyId, categoryId])
  @@map("property_categories")
}

// ============================================================
// Bookings
// ============================================================

model Booking {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  propertyId String   @map("property_id")
  checkIn    DateTime @map("check_in")
  checkOut   DateTime @map("check_out")
  guests     Int
  totalPrice Float    @map("total_price")
  status     String   @default("pending") // pending | confirmed | cancelled | completed
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  @@map("bookings")
}

// ============================================================
// Chat System
// ============================================================

model ChatSession {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
visitorId String?  @map("visitor_id") // For anonymous visitors
  adminId   String?  @map("admin_id")
  status    String   @default("active") // active | closed
  isBot     Boolean  @default(true) @map("is_bot")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User?         @relation("UserSessions", fields: [userId], references: [id])
  admin    User?         @relation("AdminSessions", fields: [adminId], references: [id])
  messages ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  senderId  String?  @map("sender_id")
  content   String
  isBot     Boolean  @default(false) @map("is_bot")
  createdAt DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender  User?       @relation(fields: [senderId], references: [id])

  @@map("chat_messages")
}

// ============================================================
// Airbnb Import
// ============================================================

model AirbnbImport {
  id         String    @id @default(cuid())
  airbnbUrl  String    @map("airbnb_url")
  airbnbId   String    @unique @map("airbnb_id")
  rawData    String    @default("{}") @map("raw_data") // JSON stored as string
  lastSynced DateTime? @map("last_synced")
  syncStatus String    @default("pending") @map("sync_status") // pending | synced | failed
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  property Property?

  @@map("airbnb_imports")
}

// ============================================================
// System Logs
// ============================================================

model SystemLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  metadata  String   @default("{}") // JSON stored as string
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("system_logs")
}

